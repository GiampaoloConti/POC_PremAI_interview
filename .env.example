# Copy this file to .env and fill in what you need. Every line is optional.
# The app reads .env when it starts. The file is ignored by git: never commit a key.

# The key of the real model. Leave it empty to run on the offline mock.
ANTHROPIC_API_KEY=

# Which Claude model to use. The default is claude-opus-5-5; a smaller one answers faster.
# ANTHROPIC_MODEL=claude-haiku-5-5

# Use the offline mock even when a key is set.
# LLM_MODE=mock

# Only when the app is hosted: its public address, used for the links in the emails.
# PUBLIC_URL=https://your-app.example.com
